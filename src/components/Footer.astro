---
import withBase from "@utils/withBase";
import Socials from "./Socials.astro";
import { SITE } from "@config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`site-footer ${noMarginTop ? "" : "mt-auto"}`}>
  <div class="container-wide footer-inner">
    <div class="footer-brand">
      <a href={withBase("/")} class="footer-title">{SITE.title}</a>
      <p>
        Practical stories from the life sciences and health research community,
        shared by TDCC LSH.
      </p>
    </div>
    <div class="footer-side">
      <nav aria-label="Footer">
        <a href={withBase("/stories/")}>Stories</a>
        <a href={withBase("/topics/")}>Topics</a>
        <a href={withBase("/about/")}>About</a>
        <a href={withBase("/rss.xml")}>RSS</a>
      </nav>
      <Socials />
    </div>
  </div>
  <div class="container-wide footer-bottom">
    © {currentYear} {SITE.author}
  </div>
</footer>

<style>
  .site-footer {
    @apply mt-24 w-full border-t border-skin-line bg-skin-card-muted;
  }
  .footer-inner {
    @apply flex flex-col gap-8 py-12 sm:flex-row sm:items-start sm:justify-between;
  }
  .footer-brand {
    @apply max-w-sm;
  }
  .footer-title {
    @apply font-display text-lg font-extrabold;
  }
  .footer-brand p {
    @apply mt-2 text-sm text-skin-muted;
  }
  .footer-side {
    @apply flex flex-col gap-4 sm:items-end;
  }
  .footer-side nav {
    @apply flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold;
  }
  .footer-side nav a {
    @apply hover:text-skin-accent;
  }
  .footer-bottom {
    @apply border-t border-skin-line py-5 text-xs text-skin-muted;
  }
</style>
