---
export interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl: string;
  nextUrl: string;
}

const { currentPage, totalPages, prevUrl, nextUrl } = Astro.props;

const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {hasPrev ? (
        <a href={prevUrl} class="btn page-btn" aria-label="Previous">
          ← Previous
        </a>
      ) : (
        <span class="btn page-btn disabled">← Previous</span>
      )}
      <span class="text-sm text-skin-muted">
        Page {currentPage} of {totalPages}
      </span>
      {hasNext ? (
        <a href={nextUrl} class="btn page-btn" aria-label="Next">
          Next →
        </a>
      ) : (
        <span class="btn page-btn disabled">Next →</span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    @apply mx-auto mt-12 flex w-full max-w-6xl px-4 items-center justify-center gap-4;
  }
  .page-btn {
    @apply border border-skin-line bg-skin-card hover:border-skin-accent;
  }
  .disabled {
    @apply pointer-events-none opacity-40;
  }
</style>
