---
import socialIcons from "@assets/socialIcons";

const url = encodeURIComponent(Astro.url.href);

const shareLinks = [
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`,
    linkTitle: "Share this story on LinkedIn",
  },
  {
    name: "Mail",
    href: `mailto:?subject=${encodeURIComponent("A story worth reading")}&body=${url}`,
    linkTitle: "Share this story via email",
  },
] as const;
---

<div class="share">
  <span>Share this story</span>
  <div class="flex gap-2">
    {
      shareLinks.map(social => (
        <a
          href={social.href}
          class="share-link group"
          title={social.linkTitle}
          target="_blank"
          rel="noopener"
        >
          <Fragment set:html={socialIcons[social.name]} />
          <span class="sr-only">{social.linkTitle}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .share {
    @apply flex items-center gap-3 text-sm font-semibold text-skin-muted;
  }
  .share-link {
    @apply flex h-10 w-10 items-center justify-center rounded-full border border-skin-line bg-skin-card transition hover:-translate-y-0.5 hover:border-skin-accent;
  }
</style>
