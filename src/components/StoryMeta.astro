---
import type { CollectionEntry } from "astro:content";
import { audienceLabel } from "@utils/storyMeta";

export interface Props {
  data: CollectionEntry<"blog">["data"];
}

const { audience, organisations, contact } = Astro.props.data;

const hasContact = contact && (contact.name || contact.email || contact.url);
const hasAny = audience.length > 0 || organisations.length > 0 || hasContact;
---

{
  hasAny && (
    <dl class="story-meta">
      {audience.length > 0 && (
        <div>
          <dt>Key audience</dt>
          <dd class="flex flex-wrap gap-1.5">
            {audience.map(a => (
              <span class="chip">{audienceLabel(a)}</span>
            ))}
          </dd>
        </div>
      )}
      {organisations.length > 0 && (
        <div>
          <dt>Organisations</dt>
          <dd>{organisations.join(", ")}</dd>
        </div>
      )}
      {hasContact && (
        <div>
          <dt>Contact</dt>
          <dd>
            {contact.url ? (
              <a href={contact.url}>{contact.name ?? contact.url}</a>
            ) : (
              contact.name
            )}
            {contact.email && (
              <>
                {(contact.name || contact.url) && " · "}
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </>
            )}
          </dd>
        </div>
      )}
    </dl>
  )
}

<style>
  .story-meta {
    @apply -mt-8 grid gap-3 sm:grid-cols-3;
  }
  .story-meta > div {
    @apply rounded-2xl border border-skin-line bg-skin-card p-4 shadow-sm;
  }
  .story-meta dt {
    @apply text-[0.7rem] font-bold uppercase tracking-wider text-skin-muted;
  }
  .story-meta dd {
    @apply mt-2 text-sm font-medium;
  }
  .story-meta a {
    @apply text-skin-accent hover:underline;
  }
</style>
