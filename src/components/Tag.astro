---
import withBase from "@utils/withBase";
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class="inline-block">
  <a
    href={withBase(`/topics/${tag}/`)}
    transition:name={tag}
    class={`topic-chip ${size === "lg" ? "topic-chip--lg" : ""}`}
  >
    {tag}
  </a>
</li>

<style>
  .topic-chip {
    @apply inline-flex items-center rounded-full border border-skin-line bg-skin-card px-3 py-1 text-sm font-medium text-skin-base transition hover:-translate-y-0.5 hover:border-skin-accent hover:text-skin-accent;
  }
  .topic-chip::before {
    content: "#";
    @apply mr-0.5 text-skin-accent opacity-70;
  }
  .topic-chip--lg {
    @apply px-4 py-2 text-base;
  }
</style>
