---
import withBase from "@utils/withBase";
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout title={`Stories | ${SITE.title}`}>
  <Header activeNav="stories" />
  <Main pageTitle="Stories" pageDesc="All stories from the community.">
    <ul>
      {
        paginatedPosts.map(({ data, slug }) => (
          <Card href={withBase(`/stories/${slug}/`)} frontmatter={data} />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={withBase(
      `/stories${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`
    )}
    nextUrl={withBase(`/stories/${currentPage + 1}/`)}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
