---
import withBase from "@utils/withBase";
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName } = Astro.props;
---

<Layout title={`Topic: ${tagName} | ${SITE.title}`}>
  <Header activeNav="topics" />
  <Main
    eyebrow="Topic"
    pageTitle={[`#`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All stories on the topic "${tagName}".`}
  >
    <ul class="story-grid">
      {
        paginatedPosts.map(({ data, slug }) => (
          <Card href={withBase(`/stories/${slug}/`)} frontmatter={data} />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={withBase(`/topics/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }/`)}
    nextUrl={withBase(`/topics/${tag}/${currentPage + 1}/`)}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
