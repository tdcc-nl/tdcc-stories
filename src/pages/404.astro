---
import withBase from "@utils/withBase";
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="container-narrow not-found">
    <p class="code" aria-hidden="true">404</p>
    <h1>This page doesn't exist</h1>
    <p class="mt-3 text-skin-muted">
      It may have moved, or the link might be wrong.
    </p>
    <a href={withBase("/")} class="btn btn-home">Back to the home page</a>
  </main>

  <Footer />
</Layout>

<style>
  .not-found {
    @apply flex flex-1 flex-col items-center justify-center py-24 text-center;
  }
  .code {
    @apply bg-gradient-to-r from-skin-accent to-skin-accent-2 bg-clip-text font-display text-8xl font-extrabold text-transparent sm:text-9xl;
  }
  h1 {
    @apply mt-4 text-3xl font-extrabold;
  }
  .btn-home {
    @apply mt-8 bg-skin-accent text-skin-inverted;
  }
</style>
