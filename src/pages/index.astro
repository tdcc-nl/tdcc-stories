---
import withBase from "@utils/withBase";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import getSortedPosts from "@utils/getSortedPosts";
import getUniqueTags from "@utils/getUniqueTags";
import Tag from "@components/Tag.astro";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts
  .filter(({ data }) => !data.featured)
  .slice(0, 6);
const topics = getUniqueTags(posts).slice(0, 12);
---

<Layout>
  <Header />
  <main id="main-content">
    <section class="hero">
      <div class="container-wide hero-inner">
        <p class="hero-eyebrow">Stories from the community</p>
        <h1>
          Learn from what others have already built
        </h1>
        <p class="hero-lead">
          Practical stories from life sciences and health in the Netherlands.
          How people set up data stewardship programmes, ran communities,
          developed interoperable software and put research infrastructure in
          place, and what they would do differently next time.
        </p>
        <div class="hero-actions">
          <a href={withBase("/stories/")} class="btn btn-primary">
            Browse stories →
          </a>
          <a href={withBase("/topics/")} class="btn btn-secondary">
            Explore topics
          </a>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="container-wide section">
          <h2 class="section-title">Featured</h2>
          <ul class="story-grid">
            {featuredPosts.map(({ data, slug }) => (
              <Card
                href={withBase(`/stories/${slug}/`)}
                frontmatter={data}
                secHeading={false}
                variant="feature"
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="container-wide section">
          <div class="section-head">
            <h2 class="section-title">Recent stories</h2>
            <a href={withBase("/stories/")} class="section-link">
              All stories →
            </a>
          </div>
          <ul class="story-grid">
            {recentPosts.map(({ data, slug }) => (
              <Card
                href={withBase(`/stories/${slug}/`)}
                frontmatter={data}
                secHeading={false}
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      topics.length > 0 && (
        <section class="container-wide section">
          <div class="section-head">
            <h2 class="section-title">Topics</h2>
            <a href={withBase("/topics/")} class="section-link">
              All topics →
            </a>
          </div>
          <ul class="flex flex-wrap gap-3">
            {topics.map(({ tag }) => (
              <Tag tag={tag} size="lg" />
            ))}
          </ul>
        </section>
      )
    }

    <section class="container-wide section">
      <div class="cta">
        <div>
          <h2>Have a story to share?</h2>
          <p>
            Set up a fellowship, grew a community or built a piece of
            infrastructure? Others can learn from it.
          </p>
        </div>
        <a href={withBase("/about/")} class="btn btn-accent">How to contribute</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    @apply relative border-b border-skin-line bg-skin-card-muted;
  }
  .hero::before {
    content: "";
    @apply absolute inset-x-0 top-0 h-1;
    background: linear-gradient(
      90deg,
      rgb(var(--color-brand)),
      rgb(var(--color-accent)),
      rgb(var(--color-accent-2))
    );
  }
  .hero-inner {
    @apply relative py-16 sm:py-24;
  }
  .hero-eyebrow {
    @apply mb-4 text-xs font-bold uppercase tracking-[0.2em] text-skin-accent;
  }
  .hero h1 {
    @apply max-w-3xl font-display text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl;
  }
  .hero-lead {
    @apply mt-6 max-w-2xl text-lg text-skin-muted;
  }
  .hero-actions {
    @apply mt-8 flex flex-wrap gap-3;
  }
  .btn-primary {
    @apply bg-skin-accent text-skin-inverted shadow-sm hover:shadow-md;
  }
  .btn-secondary {
    @apply border border-skin-line bg-skin-card text-skin-base hover:border-skin-accent;
  }
  .section {
    @apply mt-16;
  }
  .section-head {
    @apply mb-6 flex items-end justify-between gap-4;
  }
  .section-title {
    @apply mb-6 text-2xl font-extrabold sm:text-3xl;
  }
  .section-head .section-title {
    @apply mb-0;
  }
  .section-link {
    @apply text-sm font-semibold text-skin-accent hover:underline;
  }
  .cta {
    @apply flex flex-col items-start justify-between gap-6 rounded-3xl border border-skin-line p-8 sm:flex-row sm:items-center sm:p-10;
    background: linear-gradient(
      120deg,
      rgb(var(--color-accent) / 0.12),
      rgb(var(--color-accent-2) / 0.12)
    );
  }
  .cta h2 {
    @apply text-2xl font-extrabold;
  }
  .cta p {
    @apply mt-2 max-w-xl text-skin-muted;
  }
  .btn-accent {
    @apply bg-skin-accent text-skin-inverted shadow-md hover:shadow-lg;
  }
</style>
